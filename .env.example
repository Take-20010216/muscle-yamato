# Supabase project URL & anon key (https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Username -> email synthesis domain (must NOT be a real domain)
# Used internally so Supabase Auth can use email-as-key while user only types name+password.
NEXT_PUBLIC_AUTH_DOMAIN=muscleyamato.local
